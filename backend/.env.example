# Server
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://gestor_documental_app:replace_me@localhost:5432/gestor_documental_dev
MIGRATION_DATABASE_URL=postgresql://gestor_documental_app:replace_me@localhost:5432/gestor_documental_dev
TEST_DATABASE_URL=postgresql://gestor_documental_app:replace_me@localhost:5432/gestor_documental_test
DATABASE_POOL_MAX=5
DATABASE_SSL=disable

# Sessions (used in the next authentication block)
SESSION_COOKIE_NAME=gestor_session
SESSION_TTL_HOURS=12
