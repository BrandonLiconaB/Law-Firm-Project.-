{
  "name": "gestor-documental-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API for the Gestor documental internal application.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "migrate": "node-pg-migrate up --envPath .env --database-url-var MIGRATION_DATABASE_URL --migrations-dir src/db/migrations --migrations-schema app_migrations --create-migrations-schema",
    "migrate:down": "node-pg-migrate down 1 --envPath .env --database-url-var MIGRATION_DATABASE_URL --migrations-dir src/db/migrations --migrations-schema app_migrations --create-migrations-schema",
    "migrate:test": "node-pg-migrate up --envPath .env --database-url-var TEST_DATABASE_URL --migrations-dir src/db/migrations --migrations-schema app_migrations --create-migrations-schema",
    "migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations --migration-filename-format index --migration-file-language js",
    "db:verify": "node --env-file=.env scripts/verifyDatabases.js",
    "admin:create": "node --env-file=.env scripts/createAdmin.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.3.0"
  }
}
